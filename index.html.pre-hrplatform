                <div class="space-y-2 pt-2 border-t border-slate-800">
                    <div class="flex items-center space-x-2 text-orange-400 font-semibold text-sm">
                        <span class="w-6 h-6 rounded-full bg-orange-500/20 flex items-center justify-center text-xs">2</span>
                        <h3>Connect on PC Browser</h3>
                    </div>
                    <ol class="list-decimal list-inside space-y-1.5 pl-2 text-xs text-slate-300 leading-relaxed">
                        <li>Click <strong class="text-slate-100">Connect Garmin FR55</strong> on this page.</li>
                        <li>Select your <strong class="text-slate-100">Garmin Device</strong> or <strong class="text-slate-100">Heart Rate Monitor</strong> from the Chrome popup list.</li>
                        <li>Click <strong class="text-slate-100">Pair</strong>.</li>
