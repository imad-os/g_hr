<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Garmin FR55 Real-Time HR Telemetry</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        slate: {
                            850: '#151e32',
                            900: '#0f172a',
                            950: '#090d16',
                        },
                        neon: {
                            red: '#ff3366',
                            orange: '#ff9933',
                            cyan: '#00f0ff',
                            green: '#00ff66'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

    <script src="https://imad-os.github.io/g/sdk/mypc-sdk.js?v=hr-ble-picker-1"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            touch-action: manipulation;
        }
        .mono-font {
            font-family: 'JetBrains Mono', monospace;
        }
        @keyframes heartbeat {
            0% { transform: scale(1); }
            15% { transform: scale(1.25); }
            30% { transform: scale(1); }
            45% { transform: scale(1.15); }
            60% { transform: scale(1); }
            100% { transform: scale(1); }
        }
        .animate-heart {
            animation: heartbeat 1s infinite ease-in-out;
        }
        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }

/* TV-safe viewport and visible focus for the remote control */
html,
body {
    width: 100%;
    min-height: 100%;
}

body {
    overflow-x: hidden;
}

#dashboard,
#dashboard > * {
    min-width: 0;
    box-sizing: border-box;
}

#dashboard button {
    min-height: 44px;
}

button:focus,
a:focus,
input:focus,
select:focus,
textarea:focus {
    outline: 3px solid #00f0ff;
    outline-offset: 4px;
}

/* Wide landscape displays: TV or desktop monitor */
@media screen and (min-width: 1100px) and (min-aspect-ratio: 6/5) {
    #dashboard {
        max-width: 1680px;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        gap: 20px;
        padding: 24px 32px 40px;
    }

    /* Bluetooth warning and connection controls */
    #dashboard > #ble-warning,
    #dashboard > div:nth-of-type(2) {
        grid-column: 1 / -1;
    }

    /* Live HR, statistics, chart and session history */
    #dashboard > div:nth-of-type(3) {
        grid-column: 1;
    }

    #dashboard > div:nth-of-type(4) {
        grid-column: 2;
    }

    #dashboard > div:nth-of-type(5) {
        grid-column: 1;
    }

    #dashboard > div:nth-of-type(6) {
        grid-column: 2;
    }

    #dashboard > div:nth-of-type(7) {
        grid-column: 1 / -1;
    }
}

/* Reduce motion for people who prefer it */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }
}
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between selection:bg-rose-500 selection:text-white">

    <div id="toast" class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-[-20px]">
        <div id="toast-content" class="bg-slate-800 border border-slate-700 text-slate-100 px-4 py-3 rounded-xl shadow-2xl flex items-center space-x-3 text-sm">
            <span id="toast-icon">ℹ️</span>
            <span id="toast-message">Notification message</span>
        </div>
    </div>

    <header class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-40 px-4 py-3 flex items-center justify-between">
        <div class="flex items-center space-x-2">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-rose-500 to-orange-500 flex items-center justify-center shadow-lg shadow-rose-500/20">
                <svg class="w-5 h-5 text-white animate-heart" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
            </div>
            <div>
                <h1 class="font-bold text-base leading-tight tracking-tight">FR55 Live HR</h1>
                <p class="text-xs text-slate-400">Garmin BLE Telemetry</p>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            <div id="conn-status-pill" class="flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-slate-800 border border-slate-700 text-xs font-medium text-slate-300">
                <span id="conn-dot" class="w-2 h-2 rounded-full bg-amber-500"></span>
                <span id="conn-text">Disconnected</span>
            </div>
            <button onclick="toggleTutorialModal(true)" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 transition-colors" title="Garmin PC Setup Tutorial">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </button>
        </div>
    </header>

    <main
    id="dashboard"
    class="flex-1 w-full max-w-7xl mx-auto p-4 pb-12 grid grid-cols-1 gap-4"
    >

        <!-- PC Compatibility & Connection Helper Banner -->
        <div id="ble-warning" class="hidden bg-amber-950/40 border border-amber-800/60 rounded-2xl p-4 text-xs text-amber-200 leading-relaxed">
            <div class="flex items-start space-x-3">
                <span class="text-lg">💻</span>
                <div>
                    <strong class="font-semibold block mb-1">PC Bluetooth Setup Info</strong>
                    To connect your Garmin FR55 directly to your PC:
                    <ul class="list-disc list-inside mt-1 space-y-1 text-[11px] text-amber-300">
                        <li>Ensure Bluetooth is turned ON in Windows/macOS Settings.</li>
                        <li>Use <strong>Google Chrome</strong> or <strong>Microsoft Edge</strong>.</li>
                        <li>Enable <strong>"Broadcast Heart Rate"</strong> on your Garmin Watch face.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Connection & Controls Card -->
        <div class="bg-slate-800/80 backdrop-blur border border-slate-700/60 rounded-2xl p-4 shadow-xl">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
                <button id="connect-btn" onclick="toggleConnection()" class="w-full sm:w-auto flex-1 bg-gradient-to-r from-rose-600 to-orange-600 hover:from-rose-500 hover:to-orange-500 text-white font-semibold py-3 px-6 rounded-xl shadow-lg shadow-rose-600/20 active:scale-95 transition-all flex items-center justify-center space-x-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
                    </svg>
                    <span id="connect-btn-text">Connect Garmin FR55</span>
                </button>
                <div class="flex items-center space-x-2 w-full sm:w-auto">
                    <button id="sim-btn" onclick="toggleSimulation()" class="flex-1 sm:flex-none px-4 py-3 bg-slate-700 hover:bg-slate-600 border border-slate-600 text-slate-200 rounded-xl font-medium text-xs transition-colors">
                        Simulate HR
                    </button>
                    <button onclick="clearData()" class="px-4 py-3 bg-slate-700/50 hover:bg-slate-700 border border-slate-600 text-slate-300 rounded-xl font-medium text-xs transition-colors" title="Reset Session Stats">
                        Reset
                    </button>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-b from-slate-800 to-slate-850 border border-slate-700/80 rounded-3xl p-6 shadow-2xl relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-40 h-40 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-12 -left-12 w-40 h-40 bg-orange-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center space-x-2">
                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
                    <span class="text-xs font-semibold tracking-wider uppercase text-slate-400">Live Heart Rate</span>
                </div>
                <div id="contact-badge" class="px-2.5 py-1 rounded-md bg-slate-900/60 border border-slate-700 text-[10px] font-medium text-slate-400 flex items-center space-x-1.5">
                    <svg class="w-3 h-3 text-slate-500" id="contact-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                    <span id="contact-text">Sensor: Waiting</span>
                </div>
            </div>

            <div class="flex items-baseline justify-center my-6 space-x-3">
                <div id="bpm-display" class="mono-font text-7xl sm:text-8xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-100 to-slate-300">
                    --
                </div>
                <div class="text-rose-500 font-bold text-xl sm:text-2xl uppercase tracking-wider">BPM</div>
            </div>

            <div class="flex justify-center mb-6">
                <div id="heart-container" class="p-3 bg-rose-500/10 border border-rose-500/20 rounded-full text-rose-500 transition-transform duration-150">
                    <svg class="w-8 h-8 animate-heart" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                </div>
            </div>

            <div class="bg-slate-900/60 border border-slate-700/50 rounded-2xl p-4 flex items-center justify-between">
                <div>
                    <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Workout Duration</div>
                    <div id="timer-display" class="mono-font text-2xl font-bold text-slate-200">00:00:00</div>
                </div>
                <div class="flex items-center space-x-2">
                    <button id="timer-toggle-btn" onclick="toggleTimer()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl text-xs shadow-md transition-colors flex items-center space-x-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span id="timer-btn-text">Start</span>
                    </button>
                    <button onclick="resetTimer()" class="p-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl border border-slate-700 text-xs transition-colors" title="Reset Timer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="bg-slate-800/80 border border-slate-700/60 rounded-2xl p-4 flex flex-col justify-between">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Max BPM</span>
                <div class="flex items-baseline space-x-1 my-2">
                    <span id="stat-max" class="mono-font text-2xl font-bold text-rose-400">0</span>
                    <span class="text-xs text-slate-500">bpm</span>
                </div>
                <div class="w-full bg-slate-700/50 rounded-full h-1 overflow-hidden">
                    <div id="max-bar" class="bg-rose-500 h-full w-0 transition-all duration-300"></div>
                </div>
            </div>

            <div class="bg-slate-800/80 border border-slate-700/60 rounded-2xl p-4 flex flex-col justify-between">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Min BPM</span>
                <div class="flex items-baseline space-x-1 my-2">
                    <span id="stat-min" class="mono-font text-2xl font-bold text-cyan-400">0</span>
                    <span class="text-xs text-slate-500">bpm</span>
                </div>
                <div class="w-full bg-slate-700/50 rounded-full h-1 overflow-hidden">
                    <div id="min-bar" class="bg-cyan-500 h-full w-0 transition-all duration-300"></div>
                </div>
            </div>

            <div class="bg-slate-800/80 border border-slate-700/60 rounded-2xl p-4 flex flex-col justify-between">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Avg BPM</span>
                <div class="flex items-baseline space-x-1 my-2">
                    <span id="stat-avg" class="mono-font text-2xl font-bold text-amber-400">0</span>
                    <span class="text-xs text-slate-500">bpm</span>
                </div>
                <div class="text-[10px] text-slate-400">Session average</div>
            </div>

            <div class="bg-slate-800/80 border border-slate-700/60 rounded-2xl p-4 flex flex-col justify-between">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Energy Expended</span>
                <div class="flex items-baseline space-x-1 my-2">
                    <span id="stat-energy" class="mono-font text-2xl font-bold text-orange-400">0</span>
                    <span class="text-xs text-slate-500">kcal</span>
                </div>
                <div class="text-[10px] text-slate-400" id="rr-interval-info">RR: -- ms</div>
            </div>
        </div>

        <div class="bg-slate-800/80 border border-slate-700/60 rounded-2xl p-4 shadow-xl">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-300">Heart Rate Sparkline (Last 60s)</h2>
                </div>
                <span id="chart-status" class="text-[10px] text-slate-500 mono-font">Real-time</span>
            </div>
            <div class="w-full h-36 bg-slate-900/60 rounded-xl border border-slate-700/40 relative overflow-hidden p-2">
                <canvas id="hr-canvas" class="w-full h-full"></canvas>
            </div>
        </div>

        <div class="bg-slate-800/80 border border-slate-700/60 rounded-2xl p-4 shadow-xl space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-300">Saved Workout Sessions</h2>
                </div>
                <div class="flex items-center space-x-2">
                    <button onclick="saveCurrentWorkout()" class="px-3 py-1.5 bg-gradient-to-r from-rose-600 to-orange-600 hover:from-rose-500 hover:to-orange-500 text-white font-semibold rounded-lg text-xs shadow-md transition-all flex items-center space-x-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
                        <span>Save Session</span>
                    </button>
                    <button onclick="exportWorkoutsCSV()" class="px-2.5 py-1.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-lg text-xs font-medium transition-colors" title="Export CSV">
                        Export CSV
                    </button>
                </div>
            </div>

            <div id="workout-history-list" class="space-y-2 max-h-48 overflow-y-auto pr-1">
                <div class="text-center py-6 text-xs text-slate-500 italic">
                    No saved workout sessions yet. Click "Save Session" after your workout to store it here.
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-r from-slate-800 to-slate-850 border border-slate-700/60 rounded-2xl p-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-center text-orange-400 flex-shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-slate-200">How to pair on Windows PC / Mac?</h3>
                    <p class="text-xs text-slate-400">Step-by-step Bluetooth pairing instructions</p>
                </div>
            </div>
            <button onclick="toggleTutorialModal(true)" class="px-3.5 py-2 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl text-xs font-semibold transition-colors flex-shrink-0">
                View Guide
            </button>
        </div>

    </main>

    <footer class="text-center py-4 border-t border-slate-800 text-xs text-slate-500">
        Garmin Forerunner 55 Web Bluetooth HR Monitor &bull; Standard BLE 0x180D
    </footer>

    <!-- HR BLE device picker v1: selection UI for Samsung TV / My PC. -->
    <div id="hr-device-picker" class="fixed inset-0 z-[70] flex items-center justify-center bg-slate-950/90 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200 p-4">
        <div id="hr-device-picker-card" class="bg-slate-900 border border-slate-700 w-full max-w-2xl rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[88vh]">
            <div class="px-6 py-5 border-b border-slate-800 flex items-center justify-between gap-4">
                <div>
                    <h2 class="font-bold text-xl text-white">Choose heart-rate sensor</h2>
                    <p class="text-sm text-slate-400 mt-1">Select a watch or BLE heart-rate monitor using your TV remote.</p>
                </div>
                <span class="text-2xl" aria-hidden="true">⌚</span>
            </div>
            <div class="px-6 pt-4">
                <p id="hr-device-picker-status" class="text-sm text-cyan-300" aria-live="polite">Ready to scan.</p>
            </div>
            <div id="hr-device-list" class="px-6 py-4 overflow-y-auto flex-1 min-h-[160px] space-y-3">
                <div class="text-slate-400 text-sm py-8 text-center">Press Scan to find nearby heart-rate sensors.</div>
            </div>
            <div class="px-6 py-4 border-t border-slate-800 flex flex-wrap justify-end gap-3">
                <button id="hr-device-picker-rescan" type="button" onclick="scanHeartRateDevices()" class="px-5 py-3 bg-cyan-700 hover:bg-cyan-600 text-white rounded-xl font-semibold">Scan again</button>
                <button id="hr-device-picker-cancel" type="button" onclick="closeHrDevicePicker(true)" class="px-5 py-3 bg-slate-700 hover:bg-slate-600 text-white rounded-xl font-semibold">Cancel</button>
            </div>
        </div>
    </div>
    <div id="tutorial-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 p-4">
        <div id="tutorial-card" class="bg-slate-900 border border-slate-700 w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300 flex flex-col max-h-[85vh]">
            
            <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-850">
                <div class="flex items-center space-x-2">
                    <div class="w-7 h-7 rounded-lg bg-orange-500/20 text-orange-400 flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    </div>
                    <h2 class="font-bold text-base text-slate-100">PC & Garmin FR55 Connection Setup</h2>
                </div>
                <button onclick="toggleTutorialModal(false)" class="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
