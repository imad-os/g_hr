    <script>
        let bluetoothDevice = null;
        let heartRateCharacteristic = null;
        let isConnected = false;
        let isSimulating = false;
        let simulationInterval = null;

        let currentBpm = 0;
        let maxBpm = 0;
        let minBpm = 0;
        let sumBpm = 0;
        let countBpm = 0;
        let energyExpended = 0;
        let lastRrInterval = null;

        const maxChartPoints = 60;
        let hrChartData = new Array(maxChartPoints).fill(0);

        let timerSeconds = 0;
        let timerInterval = null;
        let isTimerRunning = false;

        let savedWorkouts = [];

        const connectBtn = document.getElementById('connect-btn');
        const connectBtnText = document.getElementById('connect-btn-text');
        const connDot = document.getElementById('conn-dot');
        const connText = document.getElementById('conn-text');
        const bpmDisplay = document.getElementById('bpm-display');
        const statMax = document.getElementById('stat-max');
        const statMin = document.getElementById('stat-min');
        const statAvg = document.getElementById('stat-avg');
        const statEnergy = document.getElementById('stat-energy');
        const rrIntervalInfo = document.getElementById('rr-interval-info');
        const contactBadge = document.getElementById('contact-badge');
        const contactText = document.getElementById('contact-text');
        const contactIcon = document.getElementById('contact-icon');
        const maxBar = document.getElementById('max-bar');
        const minBar = document.getElementById('min-bar');
        const timerDisplay = document.getElementById('timer-display');
        const timerToggleBtn = document.getElementById('timer-toggle-btn');
        const timerBtnText = document.getElementById('timer-btn-text');
        const simBtn = document.getElementById('sim-btn');
        const bleWarning = document.getElementById('ble-warning');
        const heartContainer = document.getElementById('heart-container');


        let hrUiInitialized = false;

function initializeHrUi() {
    // Prevent initialization from running twice.
    if (hrUiInitialized) return;
    hrUiInitialized = true;

    // The desktop guide is irrelevant when My PC supplies native TV Bluetooth.
    if (isMyPcBluetoothMode()) bleWarning.classList.add('hidden');
    else bleWarning.classList.remove('hidden');

    // Initialize dashboard.
    initCanvas();
    window.addEventListener('resize', initCanvas);
    loadWorkoutHistory();
}

// Ensure the DOM exists before initialization.
if (document.readyState === 'loading') {
    document.addEventListener(
        'DOMContentLoaded',
        initializeHrUi,
        { once: true }
    );
} else {
    initializeHrUi();
}



        function showToast(message, icon = 'ℹ️') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');
            
            toastMsg.textContent = message;
            toastIcon.textContent = icon;
            
            toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
            }, 3500);
        }

        function toggleTutorialModal(show) {
            const modal = document.getElementById('tutorial-modal');
            const card = document.getElementById('tutorial-card');
            if (show) {
                modal.classList.remove('opacity-0', 'pointer-events-none');
                modal.classList.add('opacity-100');
                card.classList.remove('scale-95');
                card.classList.add('scale-100');
            } else {
                modal.classList.remove('opacity-100');
                modal.classList.add('opacity-0', 'pointer-events-none');
                card.classList.remove('scale-100');
                card.classList.add('scale-95');
            }
        }

        /* HR BLE bridge v1: use native host BLE in My PC and Web Bluetooth elsewhere. */
        var hostBleConnecting = false;
        /* HR BLE device picker v1: user selects a discovered sensor; never auto-connect to the first result. */
        var hrDevicePickerOpen = false;
        var hrDiscoveredDevices = Object.create(null);
        var hrDeviceOrder = [];
        var hrScanGeneration = 0;
        var hrScanInFlight = false;

        function showHrDevicePicker(show) {
            var modal = document.getElementById('hr-device-picker');
            if (!modal) return;
            if (show) {
                modal.classList.remove('opacity-0', 'pointer-events-none');
                modal.classList.add('opacity-100');
            } else {
                modal.classList.remove('opacity-100');
                modal.classList.add('opacity-0', 'pointer-events-none');
            }
            hrDevicePickerOpen = !!show;
        }
        function renderHrDeviceList(emptyMessage) {
            var list = document.getElementById('hr-device-list');
            if (!list) return;
            list.innerHTML = '';
            if (!hrDeviceOrder.length) {
                var empty = document.createElement('div');
                empty.className = 'text-slate-400 text-sm py-8 text-center';
                empty.textContent = emptyMessage || 'Searching for heart-rate sensors…';
                list.appendChild(empty);
                return;
            }
            hrDeviceOrder.forEach(function (id) {
                var item = hrDiscoveredDevices[id];
                if (!item) return;
                var button = document.createElement('button');
                button.type = 'button';
                button.className = 'w-full text-left flex items-center gap-4 p-4 rounded-2xl border border-slate-700 bg-slate-800 hover:bg-slate-700 focus:bg-slate-700 transition-colors';
                button.setAttribute('data-device-id', item.id);
                var icon = document.createElement('span');
                icon.className = 'flex-shrink-0 w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-2xl';
                icon.textContent = '⌚';
                var body = document.createElement('span');
                body.className = 'flex-1 min-w-0';
                var name = document.createElement('span');
                name.className = 'block text-base font-semibold text-white break-words';
                name.textContent = item.name || 'Unnamed heart-rate sensor';
                var address = document.createElement('span');
                address.className = 'block text-xs text-slate-400 mt-1 break-all';
                address.textContent = item.address ? 'Bluetooth address: ' + item.address : 'Heart-rate service candidate';
                var action = document.createElement('span');
                action.className = 'flex-shrink-0 text-cyan-300 font-semibold';
                action.textContent = 'Connect  ›';
                body.appendChild(name);
                body.appendChild(address);
                button.appendChild(icon);
                button.appendChild(body);
                button.appendChild(action);
                button.addEventListener('click', function () { connectToHrDevice(item.id); });
                list.appendChild(button);
            });
        }
        function handleHrHostDeviceFound(event) {
            var item = event && (event.device || event);
            if (!item || !item.id) return;
            if (!hrDiscoveredDevices[item.id]) hrDeviceOrder.push(item.id);
            hrDiscoveredDevices[item.id] = item;
            if (hrDevicePickerOpen) renderHrDeviceList();
        }
        function openHrDevicePicker() {
            if (!isMyPcBluetoothMode()) return;
            hrDiscoveredDevices = Object.create(null);
            hrDeviceOrder = [];
            showHrDevicePicker(true);
            var status = document.getElementById('hr-device-picker-status');
            if (status) status.textContent = 'Scanning for nearby heart-rate sensors…';
            renderHrDeviceList('Scanning… keep your watch awake and enable Broadcast Heart Rate.');
            hostBleConnecting = true;
            connText.textContent = 'Scanning for sensors…';
            connDot.className = 'w-2 h-2 rounded-full bg-amber-500 animate-pulse';
            connectBtnText.textContent = 'Searching…';
            var rescan = document.getElementById('hr-device-picker-rescan');
            if (rescan) rescan.focus();
            scanHeartRateDevices();
        }
        async function scanHeartRateDevices() {
            if (!isMyPcBluetoothMode() || !hrDevicePickerOpen) return;
            var generation = ++hrScanGeneration;
            if (hrScanInFlight) {
                try { await MyPC.bluetooth.cancelScan(); } catch (e) {}
            }
            if (generation !== hrScanGeneration || !hrDevicePickerOpen) return;
            hrDiscoveredDevices = Object.create(null);
            hrDeviceOrder = [];
            hrScanInFlight = true;
            var status = document.getElementById('hr-device-picker-status');
            if (status) status.textContent = 'Scanning for 10 seconds… select a sensor when it appears.';
            renderHrDeviceList('Scanning… keep your watch awake and enable Broadcast Heart Rate.');
            try {
                var result = await MyPC.bluetooth.scan();
                if (generation !== hrScanGeneration || !hrDevicePickerOpen) return;
                var devices = result && result.devices ? result.devices : [];
                devices.forEach(handleHrHostDeviceFound);
                if (status) status.textContent = hrDeviceOrder.length
                    ? 'Found ' + hrDeviceOrder.length + ' compatible heart-rate sensor(s). Select one to connect.'
                    : 'No compatible heart-rate sensors found. Wake your watch, enable Broadcast Heart Rate, then scan again.';
                renderHrDeviceList('No compatible heart-rate sensors found. Wake your watch and scan again.');
            } catch (error) {
                if (generation !== hrScanGeneration) return;
                var message = error && error.message ? error.message : 'Could not scan for Bluetooth devices.';
                if (/cancel|selected/i.test(message) && !hrDevicePickerOpen) return;
                if (status) status.textContent = message;
                renderHrDeviceList('Scan failed. Check Bluetooth availability and try again.');
                if (!/cancel|selected/i.test(message)) console.error('My PC HR device scan failed:', error);
            } finally {
                if (generation === hrScanGeneration) hrScanInFlight = false;
            }
        }
        function closeHrDevicePicker(cancelScan) {
            showHrDevicePicker(false);
            hrScanGeneration++;
            if (cancelScan && isMyPcBluetoothMode()) {
                MyPC.bluetooth.cancelScan().catch(function () {});
                hrScanInFlight = false;
                hostBleConnecting = false;
                if (!isConnected) setConnectionButtonDisconnected();
            }
        }
        async function connectToHrDevice(deviceId) {
            if (!isMyPcBluetoothMode() || !deviceId) return;
            var selected = hrDiscoveredDevices[deviceId];
            if (!selected) {
                showToast('That sensor is no longer in the scan list. Scan again.', '⚠️');
                return;
            }
            showHrDevicePicker(false);
            hrScanGeneration++;
            hrScanInFlight = false;
            hostBleConnecting = true;
            connText.textContent = 'Connecting to ' + (selected.name || 'heart-rate sensor') + '…';
            connDot.className = 'w-2 h-2 rounded-full bg-amber-500 animate-pulse';
            connectBtnText.textContent = 'Connecting…';
            try {
                await MyPC.bluetooth.connect(deviceId);
            } catch (error) {
                hostBleConnecting = false;
                console.error('My PC BLE connection failed:', error);
                if (!isConnected) setConnectionButtonDisconnected();
                var message = error && error.message ? error.message : 'Could not connect to the selected sensor.';
                if (!/cancel|selected/i.test(message)) showToast(message, '⚠️');
            }
        }

        function isMyPcBluetoothMode() {
            return !!(window.MyPC && typeof MyPC.isHosted === 'function' && MyPC.isHosted() &&
                MyPC.bluetooth && typeof MyPC.bluetooth.connect === 'function');
        }
        function setConnectionButtonConnected(deviceName) {
            isConnected = true;
            connText.textContent = deviceName || 'Heart-rate sensor';
            connDot.className = 'w-2 h-2 rounded-full bg-emerald-500';
            connectBtnText.textContent = 'Disconnect Device';
            connectBtn.classList.remove('from-rose-600', 'to-orange-600');
            connectBtn.classList.add('from-slate-700', 'to-slate-800');
        }
        function setConnectionButtonDisconnected() {
            isConnected = false;
            connText.textContent = 'Disconnected';
            connDot.className = 'w-2 h-2 rounded-full bg-amber-500';
            connectBtnText.textContent = 'Connect Garmin FR55';
            connectBtn.classList.add('from-rose-600', 'to-orange-600');
            connectBtn.classList.remove('from-slate-700', 'to-slate-800');
        }
        async function toggleConnection() {
            if (isSimulating) await toggleSimulation();
            if (isMyPcBluetoothMode() && hostBleConnecting) { disconnectDevice(); return; }
            if (isConnected) { disconnectDevice(); return; }

            if (isMyPcBluetoothMode()) {
                openHrDevicePicker();
                return;
            }

            /* Normal browser fallback: Chrome/Edge Web Bluetooth. */
            if (!navigator.bluetooth) {
                showToast('Web Bluetooth is not supported in this browser. Inside Samsung TV use the My PC native BLE bridge.', '⚠️');
                return;
            }
            try {
                connText.textContent = 'Connecting…';
                connDot.className = 'w-2 h-2 rounded-full bg-amber-500 animate-pulse';
                bluetoothDevice = await navigator.bluetooth.requestDevice({ filters: [{ services: ['heart_rate'] }] });
                bluetoothDevice.addEventListener('gattserverdisconnected', onDisconnected);
                const server = await bluetoothDevice.gatt.connect();
                const service = await server.getPrimaryService('heart_rate');
                heartRateCharacteristic = await service.getCharacteristic('heart_rate_measurement');
                await heartRateCharacteristic.startNotifications();
                heartRateCharacteristic.addEventListener('characteristicvaluechanged', handleHeartRateData);
                setConnectionButtonConnected(bluetoothDevice.name || 'Heart-rate sensor');
                showToast(`Connected to ${bluetoothDevice.name || 'Heart Rate Monitor'}!`, '⚡');
            } catch (error) {
                console.error('Bluetooth connection failed:', error);
                setConnectionButtonDisconnected();
                showToast('Connection cancelled or Bluetooth not available.', '❌');
            }
        }
        function disconnectDevice() {
            if (isMyPcBluetoothMode()) {
                hostBleConnecting = false;
                MyPC.bluetooth.disconnect().catch(function (error) {
                    console.error('My PC BLE disconnect failed:', error);
                    showToast(error && error.message ? error.message : 'Could not disconnect Bluetooth.', '⚠️');
                });
                return;
            }
            if (heartRateCharacteristic) {
                try { heartRateCharacteristic.removeEventListener('characteristicvaluechanged', handleHeartRateData); } catch (e) {}
                try { heartRateCharacteristic.stopNotifications().catch(function (err) { console.log(err); }); } catch (e) {}
                heartRateCharacteristic = null;
            }
            if (bluetoothDevice && bluetoothDevice.gatt && bluetoothDevice.gatt.connected) bluetoothDevice.gatt.disconnect();
            onDisconnected();
        }
        function onDisconnected() {
            hostBleConnecting = false;
            setConnectionButtonDisconnected();
            showToast('Device disconnected.', '🔌');
        }

        function handleHeartRateData(event) {
            const value = event.target.value;
            const flags = value.getUint8(0);
            
            const is16Bit = (flags & 0x01) !== 0;
            let hrValue = 0;
            let index = 1;

            if (is16Bit) {
                hrValue = value.getUint16(index, true);
                index += 2;
            } else {
                hrValue = value.getUint8(index);
                index += 1;
            }

            const contactBit = (flags >> 1) & 0x03;
            let contactStatus = "Waiting";
            if (contactBit === 2) contactStatus = "Not Detected";
            else if (contactBit === 3) contactStatus = "Detected";

            let energy = null;
            const energyPresent = (flags & 0x08) !== 0;
            if (energyPresent) {
                energy = value.getUint16(index, true);
                index += 2;
            }

            let rrIntervals = [];
            const rrPresent = (flags & 0x10) !== 0;
            if (rrPresent) {
                while (index + 1 <= value.byteLength) {
                    const rrRaw = value.getUint16(index, true);
                    const rrMs = Math.round((rrRaw / 1024) * 1000);
                    rrIntervals.push(rrMs);
                    index += 2;
                }
            }

            updateTelemetry(hrValue, contactStatus, energy, rrIntervals.length > 0 ? rrIntervals[rrIntervals.length - 1] : null);
        }

        function updateTelemetry(bpm, contact = null, energy = null, rr = null) {
            currentBpm = bpm;
            bpmDisplay.textContent = bpm;

            pulseHeart(bpm);

            if (minBpm === 0 || bpm < minBpm) minBpm = bpm;
            if (bpm > maxBpm) maxBpm = bpm;

            sumBpm += bpm;
            countBpm++;
            const avgBpm = Math.round(sumBpm / countBpm);

            statMax.textContent = maxBpm;
            statMin.textContent = minBpm;
            statAvg.textContent = avgBpm;

            maxBar.style.width = Math.min(100, (maxBpm / 200) * 100) + '%';
            minBar.style.width = Math.min(100, (minBpm / 200) * 100) + '%';

            if (energy !== null) {
                energyExpended = energy;
                statEnergy.textContent = energyExpended;
            }

            if (rr !== null) {
                lastRrInterval = rr;
                rrIntervalInfo.textContent = `RR: ${lastRrInterval} ms`;
            }

            if (contact !== null) {
                contactText.textContent = `Sensor: ${contact}`;
                if (contact === 'Detected') {
                    contactBadge.className = "px-2.5 py-1 rounded-md bg-emerald-950/60 border border-emerald-800/80 text-[10px] font-medium text-emerald-300 flex items-center space-x-1.5";
                    contactIcon.classList.remove('text-slate-500');
                    contactIcon.classList.add('text-emerald-400');
                } else {
                    contactBadge.className = "px-2.5 py-1 rounded-md bg-amber-950/60 border border-amber-800/80 text-[10px] font-medium text-amber-300 flex items-center space-x-1.5";
                    contactIcon.classList.remove('text-slate-500');
                    contactIcon.classList.add('text-amber-400');
                }
            }

            hrChartData.shift();
            hrChartData.push(bpm);
            drawChart();
        }

        function pulseHeart(bpm) {
            const duration = 60 / Math.max(40, Math.min(200, bpm));
            heartContainer.style.animationDuration = `${duration}s`;
        }

        /* HR BLE test mode v1: on My PC, simulation originates in the host bridge. */
        function setSimulationButtonState(active) {
            var hostedMode = isMyPcBluetoothMode();
            simBtn.textContent = active
                ? (hostedMode ? 'Stop Test Data' : 'Stop Simulation')
                : (hostedMode ? 'Start Test Data' : 'Simulate HR');
            simBtn.className = active
                ? 'flex-1 sm:flex-none px-4 py-3 bg-rose-600 hover:bg-rose-500 text-white rounded-xl font-medium text-xs transition-colors shadow-lg shadow-rose-600/30'
                : 'flex-1 sm:flex-none px-4 py-3 bg-slate-700 hover:bg-slate-600 border border-slate-600 text-slate-200 rounded-xl font-medium text-xs transition-colors';
        }

        async function toggleSimulation() {
            if (isMyPcBluetoothMode()) {
                if (isSimulating) {
                    try {
                        await MyPC.bluetooth.stopTest();
                    } catch (error) {
                        console.error('Could not stop My PC test data:', error);
                        showToast(error && error.message ? error.message : 'Could not stop test data.', '⚠️');
                    }
                    isSimulating = false;
                    clearInterval(simulationInterval);
                    simulationInterval = null;
                    setSimulationButtonState(false);
                    if (!isConnected) setConnectionButtonDisconnected();
                    showToast('Stopped My PC test data.', '🛑');
                    return;
                }

                /* The host cancels any scan and disconnects a real sensor before simulating. */
                isConnected = false;
                hostBleConnecting = false;
                isSimulating = true;
                setSimulationButtonState(true);
                connText.textContent = 'Starting test data…';
                connDot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
                try {
                    await MyPC.bluetooth.startTest();
                } catch (error) {
                    isSimulating = false;
                    setSimulationButtonState(false);
                    setConnectionButtonDisconnected();
                    console.error('Could not start My PC test data:', error);
                    showToast(error && error.message ? error.message : 'Could not start test data.', '⚠️');
                }
                return;
            }

            /* Standalone browser fallback: retain the original local simulation. */
            if (isConnected) disconnectDevice();
            isSimulating = !isSimulating;
            setSimulationButtonState(isSimulating);
            if (isSimulating) {
                connText.textContent = 'Simulating FR55';
                connDot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
                showToast('Started HR simulation mode.', '🧪');
                var simBpm = 115;
                var calories = 45;
                updateTelemetry(simBpm, 'Detected', calories, 620);
                simulationInterval = setInterval(function () {
                    var delta = Math.floor(Math.random() * 5) - 2;
                    simBpm = Math.max(90, Math.min(175, simBpm + delta));
                    calories += Math.random() < 0.2 ? 1 : 0;
                    var rrSim = Math.round(60000 / simBpm + (Math.random() * 40 - 20));
                    updateTelemetry(simBpm, 'Detected', calories, rrSim);
                }, 1000);
            } else {
                clearInterval(simulationInterval);
                simulationInterval = null;
                if (!isConnected) setConnectionButtonDisconnected();
                showToast('Stopped HR simulation.', '🛑');
            }
        }
        function clearData() {
            currentBpm = 0;
            maxBpm = 0;
            minBpm = 0;
            sumBpm = 0;
            countBpm = 0;
            energyExpended = 0;
            lastRrInterval = null;

            bpmDisplay.textContent = "--";
            statMax.textContent = "0";
            statMin.textContent = "0";
            statAvg.textContent = "0";
            statEnergy.textContent = "0";
            rrIntervalInfo.textContent = "RR: -- ms";
            maxBar.style.width = "0%";
            minBar.style.width = "0%";
            hrChartData = new Array(maxChartPoints).fill(0);
            drawChart();
            showToast("Session telemetry reset.", "🔄");
        }

        function saveCurrentWorkout() {
            if (countBpm === 0 && timerSeconds === 0) {
                showToast("No workout data recorded yet to save.", "⚠️");
                return;
            }

            const avgBpm = countBpm > 0 ? Math.round(sumBpm / countBpm) : 0;
            const hrs = String(Math.floor(timerSeconds / 3600)).padStart(2, '0');
            const mins = String(Math.floor((timerSeconds % 3600) / 60)).padStart(2, '0');
            const secs = String(timerSeconds % 60).padStart(2, '0');
            const durationFormatted = `${hrs}:${mins}:${secs}`;

            const now = new Date();
            const dateStr = now.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            const newWorkout = {
                id: Date.now(),
                date: `${dateStr}, ${timeStr}`,
                duration: durationFormatted,
                durationSec: timerSeconds,
                maxBpm: maxBpm,
                minBpm: minBpm > 0 ? minBpm : 0,
                avgBpm: avgBpm,
                calories: energyExpended
            };

            savedWorkouts.unshift(newWorkout);
            try {
                localStorage.setItem('garmin_saved_workouts', JSON.stringify(savedWorkouts));
            } catch (e) {
                console.error("Could not save to localStorage", e);
            }

            renderWorkoutHistory();
            showToast("Workout session saved successfully!", "💾");
        }

        function loadWorkoutHistory() {
            try {
                const stored = localStorage.getItem('garmin_saved_workouts');
                if (stored) {
                    savedWorkouts = JSON.parse(stored);
                    renderWorkoutHistory();
                }
            } catch (e) {
                console.error("Could not load from localStorage", e);
            }
        }

        function deleteWorkout(id) {
            savedWorkouts = savedWorkouts.filter(w => w.id !== id);
            try {
                localStorage.setItem('garmin_saved_workouts', JSON.stringify(savedWorkouts));
            } catch (e) {
                console.error(e);
            }
            renderWorkoutHistory();
            showToast("Workout deleted.", "🗑️");
        }

        function renderWorkoutHistory() {
            const listEl = document.getElementById('workout-history-list');
            if (!savedWorkouts || savedWorkouts.length === 0) {
                listEl.innerHTML = `
                    <div class="text-center py-6 text-xs text-slate-500 italic">
                        No saved workout sessions yet. Click "Save Session" after your workout to store it here.
                    </div>
                `;
                return;
            }

            let html = '';
            savedWorkouts.forEach(w => {
                html += `
                    <div class="bg-slate-900/60 border border-slate-700/50 rounded-xl p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div>
                            <div class="flex items-center space-x-2">
                                <span class="text-xs font-bold text-slate-200">${w.date}</span>
                                <span class="px-2 py-0.5 rounded bg-slate-800 text-[10px] text-rose-400 font-mono font-semibold">${w.duration}</span>
                            </div>
                            <div class="flex items-center space-x-3 mt-1 text-[11px] text-slate-400">
                                <span>Avg: <strong class="text-amber-400">${w.avgBpm} bpm</strong></span>
                                <span>Max: <strong class="text-rose-400">${w.maxBpm} bpm</strong></span>
                                <span>Cal: <strong class="text-orange-400">${w.calories} kcal</strong></span>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2 self-end sm:self-center">
                            <button onclick="deleteWorkout(${w.id})" class="p-1.5 hover:bg-slate-800 text-slate-400 hover:text-rose-400 rounded-lg transition-colors" title="Delete Session">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </div>
                    </div>
                `;
            });
            listEl.innerHTML = html;
        }

        function exportWorkoutsCSV() {
            if (!savedWorkouts || savedWorkouts.length === 0) {
                showToast("No workout sessions to export.", "⚠️");
                return;
            }

            let csv = 'Date,Duration,Avg BPM,Max BPM,Min BPM,Calories (kcal)\n';
            savedWorkouts.forEach(w => {
                csv += `"${w.date}","${w.duration}",${w.avgBpm},${w.maxBpm},${w.minBpm},${w.calories}\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `garmin_workouts_${new Date().toISOString().slice(0,10)}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            showToast("Workouts exported as CSV!", "📥");
        }

        function toggleTimer() {
            isTimerRunning = !isTimerRunning;
            if (isTimerRunning) {
                timerToggleBtn.className = "px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white font-semibold rounded-xl text-xs shadow-md transition-colors flex items-center space-x-1.5";
                timerBtnText.textContent = "Pause";
                timerInterval = setInterval(() => {
                    timerSeconds++;
                    updateTimerDisplay();
                }, 1000);
            } else {
                timerToggleBtn.className = "px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl text-xs shadow-md transition-colors flex items-center space-x-1.5";
                timerBtnText.textContent = "Resume";
                clearInterval(timerInterval);
            }
        }

        function resetTimer() {
            isTimerRunning = false;
            clearInterval(timerInterval);
            timerSeconds = 0;
            updateTimerDisplay();
            timerToggleBtn.className = "px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl text-xs shadow-md transition-colors flex items-center space-x-1.5";
            timerBtnText.textContent = "Start";
        }

        function updateTimerDisplay() {
            const hrs = String(Math.floor(timerSeconds / 3600)).padStart(2, '0');
            const mins = String(Math.floor((timerSeconds % 3600) / 60)).padStart(2, '0');
            const secs = String(timerSeconds % 60).padStart(2, '0');
            timerDisplay.textContent = `${hrs}:${mins}:${secs}`;
        }

        const canvas = document.getElementById('hr-canvas');
        const ctx = canvas.getContext('2d');

        function initCanvas() {
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;

            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.scale(dpr, dpr);
            drawChart();
        }

        function drawChart() {
            const width = canvas.clientWidth;
            const height = canvas.clientHeight;
            if (!width || !height) return;

            ctx.clearRect(0, 0, width, height);

            ctx.strokeStyle = '#1e293b';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(0, height * 0.25); ctx.lineTo(width, height * 0.25);
            ctx.moveTo(0, height * 0.50); ctx.lineTo(width, height * 0.50);
            ctx.moveTo(0, height * 0.75); ctx.lineTo(width, height * 0.75);
            ctx.stroke();

            const maxVal = Math.max(180, ...hrChartData) + 10;
            const minVal = Math.max(40, Math.min(...hrChartData.filter(v => v > 0)) - 10);
            const range = maxVal - minVal || 1;

            const stepX = width / (maxChartPoints - 1);

            const gradient = ctx.createLinearGradient(0, 0, 0, height);
            gradient.addColorStop(0, 'rgba(255, 51, 102, 0.3)');
            gradient.addColorStop(1, 'rgba(255, 51, 102, 0.0)');

            ctx.beginPath();
            ctx.moveTo(0, height);
            for (let i = 0; i < hrChartData.length; i++) {
                const val = hrChartData[i];
                const x = i * stepX;
                const y = val === 0 ? height : height - ((val - minVal) / range) * (height - 10) - 5;
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.lineTo(width, height);
            ctx.closePath();
            ctx.fillStyle = gradient;
            ctx.fill();

            ctx.beginPath();
            let started = false;
            for (let i = 0; i < hrChartData.length; i++) {
                const val = hrChartData[i];
                if (val === 0) continue;
                const x = i * stepX;
                const y = height - ((val - minVal) / range) * (height - 10) - 5;
                if (!started) {
                    ctx.moveTo(x, y);
                    started = true;
                } else {
                    ctx.lineTo(x, y);
                }
            }
            ctx.strokeStyle = '#ff3366';
            ctx.lineWidth = 2.5;
            ctx.lineJoin = 'round';
            ctx.stroke();
        }

function getRemoteFocusable() {
    var picker = document.getElementById('hr-device-picker');
    var pickerOpen = picker && picker.classList.contains('opacity-100');
    var tutorial = document.getElementById('tutorial-modal');
    var tutorialOpen = tutorial && tutorial.classList.contains('opacity-100');
    return Array.prototype.slice.call(document.querySelectorAll(
        'button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled])'
    )).filter(function (element) {
        if (pickerOpen) return !!element.closest('#hr-device-picker');
        if (tutorialOpen) return !!element.closest('#tutorial-modal');
        if (element.closest('#hr-device-picker') || element.closest('#tutorial-modal')) return false;
        var style = window.getComputedStyle(element);
        return style.display !== 'none' && style.visibility !== 'hidden' && element.getClientRects().length > 0;
    });
}
function moveRemoteFocus(direction) {
    var items = getRemoteFocusable();

    if (!items.length) return;

    var current = document.activeElement;

    if (items.indexOf(current) === -1) {
        items[0].focus();
        return;
    }

    var currentRect = current.getBoundingClientRect();
    var currentX = currentRect.left + currentRect.width / 2;
    var currentY = currentRect.top + currentRect.height / 2;

    var best = null;
    var bestScore = Infinity;

    items.forEach(function (element) {
        if (element === current) return;

        var rect = element.getBoundingClientRect();
        var x = rect.left + rect.width / 2;
        var y = rect.top + rect.height / 2;
        var dx = x - currentX;
        var dy = y - currentY;

        var horizontal =
            direction === 'left' || direction === 'right';

        var forward =
            direction === 'left' ? dx < -1 :
            direction === 'right' ? dx > 1 :
            direction === 'up' ? dy < -1 :
            direction === 'down' ? dy > 1 : false;

        if (!forward) return;

        var primary = horizontal ? Math.abs(dx) : Math.abs(dy);
        var cross = horizontal ? Math.abs(dy) : Math.abs(dx);
        var score = primary + cross * 1.5;

        if (score < bestScore) {
            bestScore = score;
            best = element;
        }
    });

    if (best) best.focus();
}

function handleMyPcInput(action, pressed) {
    if (!pressed) return;
    var picker = document.getElementById('hr-device-picker');
    var pickerOpen = picker && picker.classList.contains('opacity-100');
    var tutorial = document.getElementById('tutorial-modal');
    var tutorialOpen = tutorial && tutorial.classList.contains('opacity-100');
    if (action === 'cancel') {
        if (pickerOpen) closeHrDevicePicker(true);
        else if (tutorialOpen) toggleTutorialModal(false);
        return;
    }
    if (action === 'confirm') {
        var items = getRemoteFocusable();
        var active = document.activeElement;
        if (items.indexOf(active) !== -1) active.click();
        else if (items.length) items[0].focus();
        return;
    }
    if (action === 'left' || action === 'right' || action === 'up' || action === 'down') {
        moveRemoteFocus(action);
    }
}


        var hostBleUnsubscribers = [];
        var hostBleHandlersInstalled = false;
        function installHostBluetoothHandlers() {
            if (hostBleHandlersInstalled || !isMyPcBluetoothMode()) return;
            hostBleHandlersInstalled = true;
            setSimulationButtonState(false);
            hostBleUnsubscribers.push(MyPC.bluetooth.on('device-found', handleHrHostDeviceFound));
            hostBleUnsubscribers.push(MyPC.bluetooth.on('reading', function (reading) {
                if (!reading || typeof reading.bpm !== 'number' || reading.bpm <= 0) return;
                updateTelemetry(reading.bpm,
                    reading.contact == null ? null : reading.contact,
                    reading.energy == null ? null : reading.energy,
                    reading.rr == null ? null : reading.rr);
            }));
            hostBleUnsubscribers.push(MyPC.bluetooth.on('status', function (event) {
                if (!event || !event.status) return;
                if (hrDevicePickerOpen && event.status === 'scanning') {
                    var pickerStatus = document.getElementById('hr-device-picker-status');
                    if (pickerStatus) pickerStatus.textContent = event.message || 'Scanning for heart-rate sensors…';
                } else if (hrDevicePickerOpen && event.status === 'scan-complete') {
                    var doneStatus = document.getElementById('hr-device-picker-status');
                    if (doneStatus && !hrDeviceOrder.length) doneStatus.textContent = 'No compatible sensors found. Wake your watch and scan again.';
                }
                if (event.status === 'test') {
                    hostBleConnecting = false;
                    isConnected = false;
                    isSimulating = true;
                    setSimulationButtonState(true);
                    connText.textContent = 'My PC Test Data';
                    connDot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
                    showToast('My PC is sending simulated heart-rate data.', '🧪');
                } else if (event.status === 'test-stopped') {
                    isSimulating = false;
                    setSimulationButtonState(false);
                    if (!isConnected) setConnectionButtonDisconnected();
                } else if (event.status === 'scanning') {
                    hostBleConnecting = true;
                    connText.textContent = 'Scanning for heart-rate sensor…';
                    connDot.className = 'w-2 h-2 rounded-full bg-amber-500 animate-pulse';
                    connectBtnText.textContent = 'Searching…';
                } else if (event.status === 'connecting') {
                    hostBleConnecting = true;
                    connText.textContent = event.deviceName || 'Connecting…';
                    connDot.className = 'w-2 h-2 rounded-full bg-amber-500 animate-pulse';
                    connectBtnText.textContent = 'Connecting…';
                } else if (event.status === 'connected') {
                    showHrDevicePicker(false);
                    hrScanGeneration++;
                    hrScanInFlight = false;
                    hostBleConnecting = false;
                    isSimulating = false;
                    setSimulationButtonState(false);
                    setConnectionButtonConnected(event.deviceName);
                    showToast('Connected to ' + (event.deviceName || 'heart-rate sensor') + '.', '⚡');
                } else if (event.status === 'disconnected') {
                    hostBleConnecting = false;
                    isSimulating = false;
                    setSimulationButtonState(false);
                    onDisconnected();
                } else if (event.status === 'error') {
                    hostBleConnecting = false;
                    isSimulating = false;
                    setSimulationButtonState(false);
                    setConnectionButtonDisconnected();
                    /* toggleConnection() reports the rejection so errors are not toasted twice. */
                }
            }));
        }

if (window.MyPC && typeof MyPC.init === 'function') {
    MyPC.init({
        onInit: function (info) {
            installHostBluetoothHandlers();
            initializeHrUi();
            MyPC.ready();
        },

        onStart: function () {
            var items = getRemoteFocusable();

            if (items.length) {
                connectBtn.focus();
            }
        },

        onPause: function () {
            // Pause simulation and workout-timer intervals here.
        },

        onResume: function () {
            // Resume intervals that were active before pausing.
        },

        onDestroy: function () {
            clearInterval(simulationInterval);
            clearInterval(timerInterval);
            window.removeEventListener('resize', initCanvas);
            hostBleUnsubscribers.forEach(function (unsubscribe) {
                try { if (typeof unsubscribe === 'function') unsubscribe(); } catch (e) {}
            });
            hostBleUnsubscribers = [];
            /* The My PC host disconnects native BLE before it destroys this iframe. */
        },

        onInput: function (action, pressed, repeat, dev) {
            handleMyPcInput(action, pressed);
        }
    });
} else {
    // Preserve normal browser use outside My PC.
    initializeHrUi();
}
