            <div class="px-6 py-4 border-t border-slate-800 bg-slate-850 flex justify-end">
                <button onclick="toggleTutorialModal(false)" class="px-5 py-2.5 bg-slate-700 hover:bg-slate-600 text-white text-xs font-semibold rounded-xl transition-colors">
